---
import { Icon } from "astro-icon/components";
---

<section class="relative w-full overflow-hidden">
    <div class="swiper hero-swiper h-[350px] sm:h-[550px] md:h-[630px]">
        <div class="swiper-wrapper">
            <div class="swiper-slide relative">
                <img
                    src="/images/hero/London-design-transparent-2.png"
                    alt="Adam Furniture London Design"
                    class="absolute inset-0 w-full h-full object-contain p-2 md:p-8"
                />
                
                <div
                    class="absolute inset-0 bg-black/40 flex items-center justify-center text-center px-4"
                >
                    <div class="max-w-3xl animate-fade-in">
                        <h2
                            class="text-4xl md:text-7xl font-bold text-white mb-4 tracking-tight drop-shadow-lg"
                        >
                           مصنع أدم للاثاث
                        </h2>
                        <p
                            class="text-lg md:text-2xl text-white/90 mb-8 max-w-xl mx-auto drop-shadow-md"
                        >
                           متخصصون فى صناعة الأثاث منذ أكثر من 15 عام فى محافظة دمياط
                        </p>
                        <a
                            href="/shop"
                            class="bg-[#D4AF37] text-white px-10 py-4 rounded-full font-bold shadow-xl hover:scale-105 transition-transform inline-block"
                        >
                           تصفح الموديلات
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<style>
    /* الألوان المخصصة للسلايدر */
    :root {
        --swiper-pagination-color: #D4AF37;
        --swiper-pagination-bullet-inactive-color: #fff;
        --swiper-pagination-bullet-inactive-opacity: 0.5;
        --swiper-pagination-bullet-size: 10px;
        --swiper-pagination-bullet-horizontal-gap: 6px;
    }

    .swiper-pagination-bullet-active {
        width: 24px;
        border-radius: 5px;
        transition: width 0.3s ease;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out forwards;
    }
</style>

<script>
    import Swiper from "swiper";

    const initHeroSwiper = () => {
        new Swiper(".hero-swiper", {
            loop: false,
        });
    };

    // التشغيل عند التحميل وبعد الانتقالات في Astro
    initHeroSwiper();
    document.addEventListener("astro:after-swap", initHeroSwiper);
</script>