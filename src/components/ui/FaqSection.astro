---
// src/components/ui/FaqSection.astro
import { Icon } from "astro-icon/components";
import { faqData } from "../../data/faqData";
---

<div class="space-y-4 w-full">
    {faqData.map((faq) => (
        <details class="group border border-slate-100 bg-white rounded-2xl overflow-hidden transition-all duration-300 open:shadow-md open:border-slate-200">
            <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors font-bold text-slate-800">
                <span class="text-sm md:text-base">{faq.question}</span>
                <div class="text-slate-400 group-open:rotate-180 transition-transform duration-300">
                    <Icon name="lucide:chevron-down" class="w-5 h-5" />
                </div>
            </summary>
            <div class="px-5 pb-5">
                <p class="text-sm leading-relaxed text-slate-600 font-medium border-t border-slate-50 pt-4">
                    {faq.answer}
                </p>
            </div>
        </details>
    ))}
</div>