---
import Layout from "../layouts/Layout.astro";
---

<Layout title="FAQ - E-COMMER">
    <section class="py-16 bg-base-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-black text-base-content uppercase tracking-tighter mb-4">
                    Frequently Asked Questions
                </h1>
                <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
                    Find answers to common questions about our products, shipping, and services.
                </p>
            </div>

            <div class="space-y-6">
                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        How do I track my order?
                    </div>
                    <div class="collapse-content">
                        <p>You can track your order by logging into your account and visiting the "Order Status" section, or by using the tracking number provided in your shipping confirmation email.</p>
                    </div>
                </div>

                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        What is your return policy?
                    </div>
                    <div class="collapse-content">
                        <p>We offer a 30-day return policy for most items. Items must be in their original condition and packaging. Please contact our support team to initiate a return.</p>
                    </div>
                </div>

                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        Do you offer international shipping?
                    </div>
                    <div class="collapse-content">
                        <p>Yes, we ship to most countries worldwide. Shipping costs and delivery times vary by location. You can see exact rates during checkout.</p>
                    </div>
                </div>

                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        How long does shipping take?
                    </div>
                    <div class="collapse-content">
                        <p>Standard shipping typically takes 3-5 business days within the US. International shipping can take 7-14 business days depending on the destination.</p>
                    </div>
                </div>

                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        Are your products covered by warranty?
                    </div>
                    <div class="collapse-content">
                        <p>Most of our products come with manufacturer warranties. Warranty terms vary by product and manufacturer. Please check the product details or contact us for specific warranty information.</p>
                    </div>
                </div>

                <div class="collapse collapse-plus bg-base-200">
                    <input type="radio" name="faq-accordion" />
                    <div class="collapse-title text-xl font-semibold">
                        How do I contact customer support?
                    </div>
                    <div class="collapse-content">
                        <p>You can reach our customer support team through the contact form on our website, by email at support@e-commer.com, or by phone at 1-800-E-COMMER.</p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-12">
                <p class="text-base-content/70 mb-4">
                    Can't find what you're looking for?
                </p>
                <a href="/contact" class="btn btn-primary">
                    Contact Us
                </a>
            </div>
        </div>
    </section>
</Layout>