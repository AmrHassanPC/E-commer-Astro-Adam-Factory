---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Shipping & Returns - E-COMMER">
    <section class="py-16 bg-base-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-black text-base-content uppercase tracking-tighter mb-4">
                    Shipping & Returns
                </h1>
                <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
                    Learn about our shipping policies and hassle-free return process.
                </p>
            </div>

            <div class="grid md:grid-cols-2 gap-12">
                <div>
                    <h2 class="text-2xl font-bold mb-6">Shipping Information</h2>
                    <div class="space-y-4">
                        <div>
                            <h3 class="font-semibold text-lg">Standard Shipping</h3>
                            <p class="text-base-content/70">3-5 business days - Free on orders over $50</p>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">Express Shipping</h3>
                            <p class="text-base-content/70">1-2 business days - $9.99</p>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">International Shipping</h3>
                            <p class="text-base-content/70">7-14 business days - Rates vary by location</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h2 class="text-2xl font-bold mb-6">Return Policy</h2>
                    <div class="space-y-4">
                        <div>
                            <h3 class="font-semibold text-lg">30-Day Returns</h3>
                            <p class="text-base-content/70">Return most items within 30 days for a full refund</p>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">Free Return Shipping</h3>
                            <p class="text-base-content/70">We cover return shipping costs for defective items</p>
                        </div>
                        <div>
                            <h3 class="font-semibold text-lg">Easy Process</h3>
                            <p class="text-base-content/70">Contact us to start your return - we'll provide a prepaid label</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-12 p-6 bg-base-200 rounded-lg">
                <h3 class="font-semibold text-lg mb-4">Return Conditions</h3>
                <ul class="list-disc list-inside space-y-2 text-base-content/70">
                    <li>Items must be in original condition and packaging</li>
                    <li>All accessories and manuals must be included</li>
                    <li>Electronics must not show signs of use beyond normal testing</li>
                    <li>Custom or personalized items are not eligible for return</li>
                </ul>
            </div>

            <div class="text-center mt-12">
                <p class="text-base-content/70 mb-4">
                    Have questions about shipping or returns?
                </p>
                <a href="/contact" class="btn btn-primary">
                    Contact Us
                </a>
            </div>
        </div>
    </section>
</Layout>