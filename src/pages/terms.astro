---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Terms of Service - E-COMMER">
    <section class="py-16 bg-base-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-black text-base-content uppercase tracking-tighter mb-4">
                    Terms of Service
                </h1>
                <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
                    Please read these terms carefully before using our website and services.
                </p>
            </div>

            <div class="prose prose-lg max-w-none">
                <h2>Acceptance of Terms</h2>
                <p>By accessing and using E-COMMER, you accept and agree to be bound by the terms and provision of this agreement.</p>

                <h2>Use License</h2>
                <p>Permission is granted to temporarily access the materials on E-COMMER for personal, non-commercial transitory viewing only.</p>

                <h2>User Responsibilities</h2>
                <p>You agree not to use the website for any unlawful purpose or to solicit others to perform unlawful acts.</p>

                <h2>Products and Services</h2>
                <p>All products and services are subject to availability. We reserve the right to discontinue any product at any time.</p>

                <h2>Limitation of Liability</h2>
                <p>In no event shall E-COMMER or its suppliers be liable for any damages arising out of the use or inability to use the website.</p>

                <h2>Contact Information</h2>
                <p>Questions about the Terms of Service should be sent to us at legal@e-commer.com.</p>
            </div>
        </div>
    </section>
</Layout>